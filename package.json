{
  "name": "calc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Калькулятор (вид «Стандартный») — учебный проект для курса тестирования",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
